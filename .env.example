# Settings for docker compose (copy to .env next to docker-compose.yml).
# On EC2 this file lives only on the server (/opt/dextool/.env); CI never copies or overwrites it.

# REQUIRED on a server: a long random password, e.g.  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# LLM (leave OPENAI_API_KEY empty to run on the rule-based agents only)
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# LangSmith tracing (optional): see every agent's decision_source (llm / rules / cached / fallback)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cadpilot
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ":80" = plain HTTP on the instance IP. A domain (pid.example.com) = automatic HTTPS via Let's Encrypt.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
