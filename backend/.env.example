# Copy to backend/.env. Leave OPENAI_API_KEY empty to run on the rule-based agents only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1). Empty = OpenAI.
OPENAI_BASE_URL=

# PostgreSQL (start it with: docker-compose up -d db). Empty = file store in backend/storage.
DATABASE_URL=postgresql://cadpilot:cadpilot@localhost:5432/cadpilot




# LangSmith tracing (optional): see every agent's decision_source (llm / rules / cached / fallback)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cadpilot
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# CRM integration (docs/CRM_INTEGRATION.md). Leave CADPILOT_CRM_API_KEY empty to switch it off.
# Address users open CadPilot at (launch links and download links are built from it)
CADPILOT_PUBLIC_URL=http://localhost:3000
# Key the CRM server sends as X-API-Key:  openssl rand -hex 32
CADPILOT_CRM_API_KEY=
# Signs the approval webhook and the download links (defaults to the API key):  openssl rand -hex 32
CADPILOT_CRM_WEBHOOK_SECRET=
# Optional: the CRM's web address, if its pages call CadPilot from the browser
CADPILOT_CORS_ORIGINS=
